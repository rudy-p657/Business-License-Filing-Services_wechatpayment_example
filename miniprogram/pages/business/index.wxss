.business-page {
  min-height: 100vh;
  padding-bottom: 132rpx;
}

.business-content {
  padding-bottom: 28rpx;
}

.company-card,
.form-card,
.report-card,
.service-card {
  padding: 30rpx;
  margin-bottom: 22rpx;
}

.company-name {
  margin-bottom: 24rpx;
  color: #202633;
  font-size: 34rpx;
  font-weight: 800;
}

.privacy-required-card {
  padding: 30rpx;
  margin-bottom: 22rpx;
}

.privacy-required-title {
  color: #202633;
  font-size: 32rpx;
  font-weight: 800;
}

.privacy-required-text {
  margin-top: 20rpx;
  color: #586273;
  font-size: 27rpx;
  line-height: 1.75;
}

.privacy-authorize-btn {
  width: 100%;
  margin-top: 24rpx;
  color: #ffffff;
  background: #1677d2;
  font-size: 29rpx;
}

.company-line {
  margin-top: 14rpx;
  color: #586273;
  font-size: 28rpx;
}

.form-row {
  display: flex;
  align-items: center;
  height: 92rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.form-row input {
  flex: 1;
  min-width: 0;
  height: 90rpx;
  color: #202633;
  font-size: 30rpx;
}

.agreement-link {
  color: #1677d2;
}

.info-modal {
  position: fixed;
  left: 6vw;
  right: 6vw;
  top: 12vh;
  z-index: 21;
  overflow: hidden;
  background: #ffffff;
  border-radius: 18rpx;
}

.info-modal-body {
  max-height: 58vh;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.p-text {
  margin-bottom: 22rpx;
  color: #4d5663;
  font-size: 27rpx;
  line-height: 1.75;
}

.modal-footer {
  width: 100%;
  height: 82rpx;
  margin-top: 18rpx;
  color: #1677d2;
  background: #f5f9ff;
  border-top: 1rpx solid #edf0f5;
  font-size: 29rpx;
  line-height: 82rpx;
}

.report-modal .info-modal-body {
  max-height: 60vh;
}

.form-label {
  flex: none;
  color: #202633;
  font-size: 31rpx;
  font-weight: 800;
}

.no-border {
  border-bottom: none;
}

.center-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin: 14rpx 0 24rpx;
  color: #1677d2;
  font-size: 32rpx;
  font-weight: 800;
}

.center-title view {
  width: 90rpx;
  height: 3rpx;
  background: #1677d2;
}

.status-box {
  padding: 24rpx;
  border: 2rpx solid #aee9c8;
  background: #f0fff7;
  color: #334155;
  border-radius: 8rpx;
  font-size: 30rpx;
}

.abnormal-box {
  display: block;
  color: #4b5563;
  background: #fff4f2;
  border-color: #ffd2cc;
}

.abnormal-box > text:first-child {
  display: inline-block;
}

.danger {
  color: #e05252;
  font-weight: 800;
}

.abnormal-reason {
  margin-top: 12rpx;
  color: #8d5652;
  line-height: 1.5;
}

.unavailable-box {
  color: #8d5652;
  background: #fff9ed;
  border-color: #f4d79a;
}

.ok {
  color: #10a46b;
  font-weight: 800;
}

.table {
  overflow: hidden;
  margin-top: 22rpx;
  border: 1rpx solid #e5eaf2;
  border-radius: 8rpx;
}

.tr {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 72rpx;
  align-items: center;
  text-align: center;
  border-top: 1rpx solid #edf0f5;
  color: #313844;
}

.tr:first-child {
  border-top: none;
}

.th {
  color: #1677d2;
  background: #f0f5ff;
  font-weight: 800;
}

.all-record {
  padding: 24rpx 0;
  color: #1677d2;
  text-align: center;
  font-weight: 700;
}

.flow-title {
  margin-top: 28rpx;
}

.flow {
  margin: 18rpx 0 22rpx;
  text-align: center;
  color: #202633;
  font-size: 33rpx;
  font-weight: 800;
}

.warn {
  padding: 18rpx 20rpx;
  background: #fff0f0;
  color: #e34848;
  line-height: 1.7;
  font-size: 27rpx;
}

.check-line {
  margin-top: 18rpx;
  color: #586273;
  font-size: 29rpx;
}

.service-title {
  margin-bottom: 22rpx;
  color: #5c6573;
  font-size: 30rpx;
}

.service-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 100rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #1677d2;
  border-radius: 10rpx;
  background: #ffffff;
}

.service-option.active {
  background: #eef7ff;
  box-shadow: inset 0 0 0 2rpx #1677d2;
}

.option-name {
  margin-bottom: 8rpx;
  color: #202633;
  font-size: 29rpx;
  font-weight: 700;
}

.option-price {
  flex: none;
  color: #d9283c;
  font-size: 31rpx;
  font-weight: 800;
}

.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 26rpx 0 34rpx;
  color: #8a94a6;
  font-size: 26rpx;
}

.radio {
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid #f35a68;
  border-radius: 50%;
}

.radio.checked {
  border-color: #1677d2;
  background: radial-gradient(circle, #1677d2 0, #1677d2 45%, #ffffff 49%);
}

.pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 118rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(28, 46, 74, 0.08);
  font-size: 31rpx;
}

.pay-btn {
  width: 250rpx;
  height: 84rpx;
  color: #ffffff;
  background: #0f66d8;
  border-radius: 44rpx;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.pay-btn.disabled {
  background: #d5d8de;
  color: #8a94a6;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.55);
}

.pay-modal {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  z-index: 21;
  box-sizing: border-box;
  width: auto;
  max-height: calc(100vh - 80rpx);
  overflow-y: auto;
  transform: translateY(-50%);
  padding: 36rpx 32rpx 28rpx;
  background: #ffffff;
  border-radius: 18rpx;
  text-align: center;
}

.modal-title {
  margin-bottom: 28rpx;
  color: #202633;
  font-size: 38rpx;
  font-weight: 800;
}

.qr {
  width: 430rpx;
  height: 430rpx;
  max-width: 76vw;
  max-height: 76vw;
  margin: 0 auto 22rpx;
  border: 1rpx solid #eef0f4;
}

.qr-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 430rpx;
  height: 430rpx;
  max-width: 76vw;
  max-height: 76vw;
  margin: 0 auto 22rpx;
  border: 1rpx dashed #b9c6d8;
  background: #f8fafc;
  color: #7c899c;
  font-size: 28rpx;
  line-height: 1.7;
}

.order-no {
  color: #8a94a6;
  font-size: 24rpx;
}

.pay-amount {
  margin-top: 8rpx;
  color: #d9283c;
  font-size: 42rpx;
  font-weight: 800;
}

.price-breakdown {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 12rpx;
  color: #8a94a6;
  font-size: 24rpx;
}

.price-breakdown text:last-child {
  color: #e34848;
}

.pay-notice {
  margin: 8rpx 0 18rpx;
  color: #d9283c;
  font-size: 28rpx;
  font-weight: 700;
}

.pay-apps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin: -8rpx 0 12rpx;
}

.pay-app-icon {
  width: 52rpx;
  height: 52rpx;
}

.modal-text {
  margin-top: 12rpx;
  color: #313844;
  font-size: 29rpx;
}

.modal-text.danger {
  color: #e34848;
  font-weight: 700;
}

.save-btn,
.done-btn {
  width: 100%;
  height: 86rpx;
  margin-top: 24rpx;
  color: #ffffff;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 86rpx;
}

.save-btn {
  background: #1677d2;
}

.done-btn {
  background: #05b676;
}

.close-btn {
  margin-top: 20rpx;
  color: #8a94a6;
  font-size: 28rpx;
}
