.page {
  padding: 32rpx;
}

.row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e8edf2;
}

.label {
  color: #697586;
  font-size: 26rpx;
}

.value {
  color: #17212b;
  font-size: 28rpx;
  word-break: break-all;
}

.probe-button {
  margin: 36rpx 0 24rpx;
  background: #1677d2;
  color: #fff;
  font-size: 28rpx;
}

.result {
  padding: 24rpx;
  border: 1rpx solid #dce4eb;
  border-radius: 8rpx;
  background: #fff;
}

.result-title {
  display: block;
  color: #17212b;
  font-size: 30rpx;
  font-weight: 600;
}

.detail {
  display: block;
  margin-top: 16rpx;
  color: #465362;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}
