.empty {
  padding-top: 180rpx;
  text-align: center;
}

.order-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding-top: 220rpx;
  color: #8a94a6;
  font-size: 29rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #dbeeff;
  border-top-color: #1677d2;
  border-radius: 50%;
  animation: order-spin 0.8s linear infinite;
}

@keyframes order-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.empty-title {
  margin-bottom: 40rpx;
  color: #8a94a6;
  font-size: 32rpx;
}

.order-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.order-top,
.order-bottom,
.meta {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.service-name {
  color: #202633;
  font-size: 31rpx;
  font-weight: 800;
}

.company {
  margin: 22rpx 0;
  color: #313844;
  font-size: 30rpx;
}

.info-line {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
  color: #313844;
  font-size: 27rpx;
}

.label {
  flex: none;
  color: #8a94a6;
}

.info-line text:last-child {
  min-width: 0;
  text-align: right;
  word-break: break-all;
}

.progress-text {
  color: #1677d2;
  font-weight: 800;
}

.refund-status-line text:last-child {
  color: #a85d00;
  font-weight: 700;
}

.remark-line {
  align-items: flex-start;
}

.remark-text {
  color: #1677d2;
  line-height: 1.5;
}

.extra-box {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border: 1rpx dashed #cdd5e0;
  border-radius: 10rpx;
  background: #f8fbff;
}

.meta {
  margin-top: 18rpx;
  color: #8a94a6;
  font-size: 24rpx;
}

.order-bottom {
  align-items: center;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf0f5;
}

.action-row {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
}

.small-btn {
  min-width: 130rpx;
  height: 58rpx;
  padding: 0 18rpx;
  color: #ffffff;
  background: #1677d2;
  border-radius: 8rpx;
  font-size: 25rpx;
  line-height: 58rpx;
}

.fill-btn {
  background: #05b676;
}

.cancel-order-btn {
  color: #66717f;
  background: #ffffff;
  border: 1rpx solid #d7dee7;
}

.refund-refresh-btn {
  color: #1769aa;
  background: #eef6fc;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.45);
}

.extra-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  padding: 34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
}

.modal-title {
  margin-bottom: 24rpx;
  color: #202633;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.form-item {
  margin-bottom: 22rpx;
}

.form-label {
  margin-bottom: 12rpx;
  color: #313844;
  font-size: 28rpx;
  font-weight: 700;
}

.form-item input {
  width: 100%;
  height: 82rpx;
  padding: 0 20rpx;
  background: #f6f8fb;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.modal-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.cancel-btn,
.submit-btn {
  flex: 1;
  height: 82rpx;
  border-radius: 41rpx;
  font-size: 29rpx;
  line-height: 82rpx;
}

.cancel-btn {
  color: #7b8493;
  background: #f2f4f7;
}

.submit-btn {
  color: #ffffff;
  background: #1677d2;
}
