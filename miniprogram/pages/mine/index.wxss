.mine-page {
  min-height: 100vh;
  background: #f4f6fa;
  padding-bottom: 56rpx;
}

.mine-banner {
  display: block;
  width: 100%;
  height: 420rpx;
}

.menu-card {
  margin: 24rpx 28rpx 28rpx;
  padding: 0 30rpx;
  position: relative;
  border-radius: 14rpx;
}

.menu-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 132rpx;
  padding: 0;
  border-bottom: 1rpx solid #edf0f5;
  color: #202633;
  font-size: 34rpx;
  font-weight: 500;
  text-align: left;
  line-height: normal;
  background: #ffffff;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-hit-button {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  opacity: 0;
  background: transparent;
}

.menu-item image {
  width: 46rpx;
  height: 46rpx;
  margin-right: 30rpx;
  flex: 0 0 46rpx;
  display: block;
}

.menu-label {
  flex: 1;
  min-width: 0;
  text-align: left;
  line-height: 1.2;
}

.arrow {
  color: #c7ddf5;
  font-size: 50rpx;
  font-weight: 300;
  line-height: 1;
}
