.result-tip {
  margin: 6rpx 0 24rpx;
  color: #8a94a6;
  font-size: 28rpx;
}

.company-card {
  padding: 28rpx 20rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 4rpx;
  box-shadow: none;
}

.company-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.company-name {
  flex: 1;
  min-width: 0;
  color: #202633;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.38;
  word-break: break-all;
}

.cert-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 142rpx;
  width: 142rpx;
  height: 64rpx;
  padding: 0;
  color: #ffffff;
  background: #197cdf;
  border-radius: 8rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 14rpx;
  color: #313844;
  font-size: 30rpx;
}

.label {
  flex: none;
  color: #9aa2ad;
}

.info-row text:last-child {
  min-width: 0;
  text-align: right;
  word-break: break-all;
}
