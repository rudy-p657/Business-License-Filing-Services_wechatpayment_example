<view class="page results-page">
  <view class="result-tip">共找到 {{companies.length}} 条企业信息</view>
  <view class="card company-card" wx:for="{{companies}}" wx:key="creditCode">
    <view class="company-head">
      <view class="company-name">{{item.name}}</view>
      <button class="cert-btn" data-code="{{item.creditCode}}" bindtap="goBusiness">立即认证</button>
    </view>
    <view class="info-row">
      <text class="label">法定代表人</text>
      <text>{{item.legalPerson}}</text>
    </view>
    <view class="info-row">
      <text class="label">成立日期</text>
      <text>{{item.establishDate}}</text>
    </view>
    <view class="info-row">
      <text class="label">统一社会信用代码</text>
      <text>{{item.creditCode}}</text>
    </view>
  </view>
</view>
