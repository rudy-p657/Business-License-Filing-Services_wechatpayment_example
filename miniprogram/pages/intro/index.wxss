.intro-page {
  padding-top: 24rpx;
}

.intro-banner {
  display: block;
  width: 100%;
  height: 330rpx;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
}

.intro-card {
  padding: 34rpx 30rpx 44rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin: 10rpx 0 28rpx;
  color: #202633;
  font-size: 38rpx;
  font-weight: 800;
}

.line {
  width: 172rpx;
  height: 2rpx;
  background: #e4e9f1;
}

.intro-text {
  color: #5c6573;
  font-size: 31rpx;
  line-height: 2;
  margin-bottom: 28rpx;
}

.strong {
  margin: 34rpx 0 12rpx;
  color: #f04a55;
  font-size: 31rpx;
  font-weight: 800;
}
