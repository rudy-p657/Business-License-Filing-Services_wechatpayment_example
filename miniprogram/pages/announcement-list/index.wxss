.announcement-page {
  padding-top: 18rpx;
}

.announcement-loading,
.announcement-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 30rpx;
  color: #8a94a6;
  text-align: center;
  font-size: 29rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 24rpx;
  border: 5rpx solid #dbeeff;
  border-top-color: #1677d2;
  border-radius: 50%;
  animation: announcement-spin 0.8s linear infinite;
}

@keyframes announcement-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.retry-btn {
  min-width: 220rpx;
  height: 76rpx;
  margin-top: 30rpx;
  color: #ffffff;
  background: #1677d2;
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}

.page-title {
  margin: 8rpx 0 26rpx;
  color: #202633;
  font-size: 42rpx;
  font-weight: 800;
}

.list-card {
  padding: 0 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.list-item {
  position: relative;
  padding: 30rpx 44rpx 28rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.list-item:last-child {
  border-bottom: none;
}

.item-title {
  color: #202633;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.45;
}

.item-date {
  margin-top: 14rpx;
  color: #9aa2ad;
  font-size: 26rpx;
}

.arrow {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  color: #d4d9e1;
  font-size: 52rpx;
}

.empty {
  padding: 110rpx 0 120rpx;
  color: #c0c6d0;
  text-align: center;
  font-size: 30rpx;
}
