.status-card,
.info-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.pending-order-actions {
  display: flex;
  gap: 18rpx;
  margin: 24rpx 0;
}

.pending-order-actions button {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.offline-payment-guide {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 0 24rpx 20rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #1688e8;
  border-radius: 8rpx;
  background: #edf6ff;
}

.offline-payment-title {
  color: #175b91;
  font-size: 28rpx;
  font-weight: 700;
}

.offline-payment-copy {
  color: #506477;
  font-size: 25rpx;
  line-height: 1.55;
}

.contact-staff-btn {
  padding: 0 16rpx;
  font-size: 27rpx;
  line-height: 1.35;
  text-align: center;
}

.ios-payment-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(18, 25, 35, 0.52);
}

.ios-payment-dialog {
  position: fixed;
  left: 52rpx;
  right: 52rpx;
  top: 50%;
  z-index: 31;
  box-sizing: border-box;
  padding: 34rpx 30rpx 26rpx;
  transform: translateY(-50%);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 60rpx rgba(18, 25, 35, 0.2);
}

.ios-payment-title {
  color: #202633;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.ios-payment-copy {
  margin-top: 18rpx;
  color: #596575;
  font-size: 27rpx;
  line-height: 1.6;
  text-align: center;
}

.ios-payment-order,
.ios-payment-amount {
  margin-top: 16rpx;
  color: #596575;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
  word-break: break-all;
}

.ios-payment-amount {
  margin-top: 6rpx;
  color: #202633;
  font-weight: 700;
}

.ios-payment-contact,
.ios-payment-dismiss {
  height: 82rpx;
  margin: 26rpx 0 0;
  border-radius: 8rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 82rpx;
}

.ios-payment-contact {
  color: #ffffff;
  background: #1677d2;
}

.ios-payment-dismiss {
  margin-top: 14rpx;
  color: #505b69;
  background: #f1f3f6;
}

.ios-payment-contact::after,
.ios-payment-dismiss::after {
  border: 0;
}

.secondary-btn.cancel-order-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  height: 88rpx;
  padding: 0 12rpx;
  border: 1rpx solid #edc2bd;
  border-radius: 44rpx;
  color: #ad4942;
  background: #fff4f2;
  font-size: 28rpx;
  font-weight: 700;
  line-height: normal;
}

.cancel-order-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  flex: none;
  border-radius: 50%;
  color: #ad4942;
  background: #fce1de;
  font-size: 30rpx;
  line-height: 30rpx;
}

.status-title {
  margin-bottom: 14rpx;
  color: #1677d2;
  font-size: 40rpx;
  font-weight: 800;
}

.info-card .section-title {
  margin-bottom: 22rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  color: #313844;
  font-size: 28rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.info-row text:first-child {
  flex: none;
  color: #8a94a6;
}

.info-row text:last-child {
  text-align: right;
  word-break: break-all;
}

.refund-status-row text:last-child {
  color: #a85d00;
  font-weight: 700;
}

.refund-refresh-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
  color: #66717f;
  background: #f5f8fb;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.refund-refresh-row text {
  flex: 1;
}

.refund-refresh-btn {
  flex: none;
  width: auto;
  min-width: 180rpx;
  margin: 0;
  padding: 0 18rpx;
  color: #1769aa;
  background: #eaf3fb;
  font-size: 25rpx;
}

.remark {
  margin-top: 20rpx;
  padding: 18rpx;
  color: #586273;
  background: #f6f8fb;
  border-radius: 10rpx;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.55);
}

.pay-modal {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  z-index: 21;
  box-sizing: border-box;
  width: auto;
  max-height: calc(100vh - 80rpx);
  overflow-y: auto;
  transform: translateY(-50%);
  padding: 36rpx 32rpx 28rpx;
  background: #ffffff;
  border-radius: 18rpx;
  text-align: center;
}

.modal-title {
  margin-bottom: 28rpx;
  color: #202633;
  font-size: 38rpx;
  font-weight: 800;
}

.qr {
  width: 430rpx;
  height: 430rpx;
  max-width: 76vw;
  max-height: 76vw;
  margin-bottom: 22rpx;
}

.qr-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 430rpx;
  height: 430rpx;
  max-width: 76vw;
  max-height: 76vw;
  margin: 0 auto 22rpx;
  border: 1rpx dashed #b9c6d8;
  background: #f8fafc;
  color: #7c899c;
  font-size: 28rpx;
  line-height: 1.7;
  text-align: center;
}

.order-no {
  color: #8a94a6;
  font-size: 24rpx;
}

.pay-amount {
  margin-top: 8rpx;
  color: #d9283c;
  font-size: 42rpx;
  font-weight: 800;
}

.price-breakdown {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 12rpx;
  color: #8a94a6;
  font-size: 24rpx;
}

.price-breakdown text:last-child {
  color: #e34848;
}

.pay-notice {
  margin: 8rpx 0 18rpx;
  color: #d9283c;
  font-size: 28rpx;
  font-weight: 700;
}

.pay-apps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin: -8rpx 0 12rpx;
}

.pay-app-icon {
  width: 52rpx;
  height: 52rpx;
}

.modal-text {
  margin-top: 12rpx;
  color: #313844;
  font-size: 29rpx;
}

.modal-text.danger {
  color: #e34848;
  font-weight: 700;
}

.save-btn {
  width: 100%;
  height: 86rpx;
  margin-top: 24rpx;
  color: #ffffff;
  background: #1677d2;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 86rpx;
}

.done-btn {
  width: 100%;
  height: 86rpx;
  margin-top: 24rpx;
  color: #ffffff;
  background: #05b676;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 86rpx;
}

.close-btn {
  margin-top: 20rpx;
  color: #8a94a6;
  font-size: 28rpx;
}
